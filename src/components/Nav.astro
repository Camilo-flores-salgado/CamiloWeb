---
const { pathname } = Astro.url;
const isHome = pathname === '/';
const isSobreMi = pathname.startsWith('/sobre-mi');

const whatsappNumber = '56958828777';
const whatsappMessage = 'Hola Camilo, vi tu sitio y quiero partir con el mío.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<header class="border-b-2 border-tinta">
	<nav class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4">
		<a
			href="/"
			class="font-display text-xl font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta"
		>
			Camilo Flores
		</a>

		<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
			<a
				href="/"
				aria-current={isHome ? 'page' : undefined}
				class:list={[
					'border-b-[3px] border-transparent font-body text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta',
					isHome ? 'border-azul font-semibold text-azul' : 'text-tinta',
				]}
			>
				Inicio
			</a>
			<a
				href="/sobre-mi"
				aria-current={isSobreMi ? 'page' : undefined}
				class:list={[
					'border-b-[3px] border-transparent font-body text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta',
					isSobreMi ? 'border-azul font-semibold text-azul' : 'text-tinta',
				]}
			>
				Sobre mí
			</a>
			<a
				href={whatsappHref}
				class="inline-flex items-center justify-center rounded border border-azul bg-azul px-4 py-2 font-body text-sm font-semibold text-cal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta"
			>
				Escríbeme
			</a>
		</div>
	</nav>
</header>
