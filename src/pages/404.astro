---
import Base from '../layouts/Base.astro';
---

<Base
	title="Página no encontrada — Camilo Flores"
	description="La página que buscas no existe. Vuelve al inicio del sitio de Camilo Flores."
	path="/404"
	noindex
>
	<main class="mx-auto flex min-h-svh max-w-2xl flex-col justify-center gap-6 px-6 py-16">
		<h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">Esta página no existe.</h1>

		<p class="font-body text-lg">
			El link que seguiste está roto o la página se movió. Vuelve al inicio y sigue desde ahí.
		</p>

		<a
			href="/"
			class="inline-flex w-fit items-center justify-center rounded border border-azul bg-azul px-6 py-3 font-body font-semibold text-cal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta"
		>
			Volver al inicio
		</a>
	</main>
</Base>
