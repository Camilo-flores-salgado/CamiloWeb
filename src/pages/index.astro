---
import Base from '../layouts/Base.astro';

const whatsappNumber = '56958828777';
const whatsappMessage = 'Hola Camilo, vi tu sitio y quiero partir con el mío.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const faqs = [
	{
		question: 'Ya tengo Instagram y Facebook. ¿Para qué una página web?',
		answer:
			'Instagram sirve para mostrarte, pero no es tuyo: si mañana te cierran la cuenta o cambian las reglas, pierdes todo tu trabajo. Tu página es tuya, está disponible de día y de noche, y aparece cuando alguien te busca por tu nombre sin depender de un algoritmo. Lo ideal es tener las dos: las redes traen gente, la página cierra la venta.',
	},
	{
		question: '¿Cuánto se demora en estar lista?',
		answer:
			'Una página de una sola sección queda en cerca de 1 semana; un sitio de varias secciones, entre 2 y 3 semanas. El plazo depende sobre todo de qué tan rápido me pases los textos y las fotos: mientras antes lleguen, antes queda.',
	},
	{
		question: 'Cuando me la entregas, ¿quién se hace cargo después?',
		answer:
			'Yo, si quieres. El sitio queda andando y es tuyo. Con el plan de soporte (desde 1 UF al mes) me encargo del hosting, los respaldos y los cambios que necesites, y te respondo el mismo día hábil. Si prefieres no tomarlo, igual queda funcionando y me escribes cuando necesites algo puntual.',
	},
	{
		question: '¿Qué necesito tener para empezar?',
		answer:
			'Poco: los textos de tu negocio (o la idea, y los ordenamos juntos), algunas fotos, y tu número de WhatsApp. No necesitas saber de computación ni comprar nada por adelantado. Si no tienes fotos buenas, lo conversamos.',
	},
	{
		question: '¿Voy a aparecer en Google?',
		answer:
			'Sí. Tu página va a aparecer cuando alguien busque el nombre de tu negocio, y la dejo lista para que Google la lea bien. Salir primero en búsquedas generales como «ferretería en San Felipe» es un trabajo aparte y más lento, de varios meses; te digo con franqueza qué es realista en tu caso en vez de prometerte el primer lugar.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};

const siteUrl = Astro.site!.toString();

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Camilo Flores',
	jobTitle: 'Desarrollador web',
	url: siteUrl,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'San Felipe',
		addressRegion: 'Valparaíso',
		addressCountry: 'CL',
	},
};

const professionalServiceJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Camilo Flores',
	url: siteUrl,
	description:
		'Sitios web para negocios del Valle de Aconcagua. Carga en menos de un segundo y contacto directo por WhatsApp.',
	areaServed: {
		'@type': 'AdministrativeArea',
		name: 'Valle de Aconcagua, Región de Valparaíso, Chile',
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'San Felipe',
		addressRegion: 'Valparaíso',
		addressCountry: 'CL',
	},
};
---

<Base
	title="Camilo Flores — sitios web para negocios del Valle de Aconcagua"
	description="Sitios que cargan en menos de un segundo y traen clientes por WhatsApp. Precio de lanzamiento para mis primeros 3 proyectos."
	path="/"
>
	<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
	<script type="application/ld+json" set:html={JSON.stringify(professionalServiceJsonLd)} is:inline />

	<section class="w-full bg-cal bg-textura-cal">
		<main class="mx-auto flex min-h-svh max-w-2xl flex-col justify-center gap-8 px-6 py-16">
			<h1 class="text-display-xl font-display font-bold">
				Le hago a tu negocio un sitio que carga en menos de un segundo y te trae clientes por{' '}
				<span class="text-azul">WhatsApp</span>.
			</h1>

			<div class="flex w-full items-stretch justify-center gap-4 my-10">
				<div class="flex flex-col justify-center">
					<span class="font-display text-xs font-bold leading-tight tracking-wide text-parra">
						tiempo de<br />carga real
					</span>
				</div>
				<div class="w-0.5 bg-tinta" aria-hidden="true"></div>
				<p class="flex items-baseline gap-1">
					<span
						id="medidor"
						class="text-display-2xl font-display font-bold leading-none tabular-nums text-azul"
						>0,00</span
					>
					<span class="font-display text-3xl font-bold leading-none text-azul">s</span>
				</p>
			</div>

			<a
				href={whatsappHref}
				class="inline-flex w-fit mx-auto items-center justify-center rounded border border-azul bg-azul px-6 py-3 font-body font-semibold text-cal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta"
			>
				Escríbeme por WhatsApp
			</a>
		</main>
	</section>

	<section class="w-full border-t-[6px] border-tinta bg-cal bg-textura-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
				Cada segundo que tarda tu sitio, se va un cliente.
			</h2>

			<p class="mt-6 font-body text-lg">
				El <span class="font-display font-bold text-rojo">53%</span> de las visitas desde el celular
				abandona una página que tarda más de tres segundos en cargar. Si tu sitio es lento, o si solo
				tienes Instagram y el cliente tiene que salir de la aplicación para escribirte, ya perdiste a
				la mitad antes de que vean qué vendes.
			</p>

			<p class="mt-4 font-body text-sm">Fuente: Google, «The Need for Mobile Speed», 2016.</p>
		</div>
	</section>

	<section class="w-full border-t border-borde bg-cal bg-textura-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">Qué hago</h2>

			<p class="mt-2 font-body text-sm">Precio de lanzamiento, mis primeros 3 proyectos.</p>

			<div class="mt-8 overflow-x-auto">
				<table class="w-full border-collapse text-left">
					<thead>
						<tr class="border-b border-borde">
							<th scope="col" class="py-3 font-body text-base font-semibold">Servicio</th>
							<th scope="col" class="py-3 font-body text-base font-semibold">Qué incluye</th>
							<th scope="col" class="py-3 text-right font-body text-base font-semibold">Precio</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b border-borde">
							<td class="py-3 align-top font-body text-base font-semibold">Una página</td>
							<td class="py-3 align-top font-body text-base">
								Todo en una sola página: quién eres, qué ofreces y cómo te contactan.
							</td>
							<td class="py-3 text-right align-top font-display text-xl font-bold text-azul">3 UF</td>
						</tr>
						<tr class="border-b border-borde">
							<td class="py-3 align-top font-body text-base font-semibold">
								Inicio + Sobre mí + Catálogo
							</td>
							<td class="py-3 align-top font-body text-base">
								Tres páginas: quién eres, tu historia y lo que vendes.
							</td>
							<td class="py-3 text-right align-top font-display text-xl font-bold text-azul">5 UF</td>
						</tr>
						<tr>
							<td class="py-3 align-top font-body text-base font-semibold">Custom</td>
							<td class="py-3 align-top font-body text-base">
								Desde cuatro páginas, con la estructura que tu negocio necesite. Cada página extra, 2
								UF más.
							</td>
							<td class="py-3 text-right align-top font-display text-xl font-bold text-azul">7 UF</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h3 class="mt-12 font-display text-2xl font-bold leading-tight">Mantención mensual</h3>

			<div class="mt-6 grid gap-6 sm:grid-cols-2">
				<div class="rounded border border-borde px-6 py-6">
					<div class="flex items-baseline justify-between gap-4">
						<h4 class="font-body text-lg font-semibold">Soporte estándar</h4>
						<p class="font-display text-xl font-bold text-azul">1 UF/mes</p>
					</div>
					<ul class="mt-4 flex flex-col gap-2 font-body text-base">
						<li>Hosting, dominio y respaldos administrados</li>
						<li>Hasta 2 cambios menores al mes (textos, precios, fotos)</li>
						<li>Respuesta en 48 horas hábiles</li>
						<li>Sitio siempre actualizado y seguro</li>
					</ul>
				</div>

				<div class="rounded border border-borde px-6 py-6">
					<div class="flex items-baseline justify-between gap-4">
						<h4 class="font-body text-lg font-semibold">Soporte prioritario</h4>
						<p class="font-display text-xl font-bold text-azul">3 UF/mes</p>
					</div>
					<ul class="mt-4 flex flex-col gap-2 font-body text-base">
						<li>Todo lo del plan estándar, sin tope de cambios menores</li>
						<li>Respuesta el mismo día hábil</li>
						<li>Reporte mensual: visitas, de dónde llegan, qué buscan</li>
						<li>Una mejora al mes (sección nueva, ajuste de textos, campaña)</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="w-full bg-azul text-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
				Todavía estoy sumando casos. Te lo digo antes de que preguntes.
			</h2>

			<p class="mt-6 font-body text-lg">
				Ya hice el sitio de un cliente real —su testimonio está aquí abajo— y trabajo como
				desarrollador en una empresa de tecnología chilena con presencia internacional. Estoy
				tomando mis primeros 3 proyectos a precio de lanzamiento: tú consigues el precio más bajo
				que vas a ver de mí, y yo sumo más trabajo que mostrar.
			</p>
		</div>
	</section>

	<section class="w-full bg-cal bg-textura-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<figure class="m-0">
				<div class="h-1 w-12 bg-azul" aria-hidden="true"></div>

				<blockquote class="mt-8 font-body text-2xl font-normal leading-relaxed sm:text-3xl">
					Trabajar con Camilo Flores fue una experiencia excelente. Fue muy proactivo, dedicado y
					creativo en todo el proceso de desarrollo y perfeccionamiento del sitio web de GVE
					Sistemas. Siempre aportó ideas claras y soluciones efectivas, cumpliendo los plazos
					establecidos y superando las expectativas.
				</blockquote>

				<figcaption class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<span class="font-display text-lg font-bold">Gonzalo Toro</span>
					<span class="font-display text-sm font-bold tracking-wide text-parra"
						>CEO · ITQ Internacional</span
					>
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="w-full border-t border-borde bg-cal bg-textura-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">Dudas frecuentes</h2>

			<div class="mt-8 divide-y divide-borde border-y border-borde">
				{
					faqs.map((faq) => (
						<details class="py-5">
							<summary class="cursor-pointer font-body text-lg font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta">
								{faq.question}
							</summary>
							<p class="mt-3 font-body text-base">{faq.answer}</p>
						</details>
					))
				}
			</div>

			<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
		</div>
	</section>

	<section class="w-full bg-azul text-cal">
		<div class="mx-auto max-w-2xl px-6 py-16">
			<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
				Menos de un segundo de carga. Una conversación por WhatsApp de distancia.
			</h2>

			<p class="mt-4 font-body text-lg">Cuéntame de tu negocio y partimos por ahí.</p>

			<a
				href={whatsappHref}
				class="mt-8 inline-flex w-fit items-center justify-center rounded border border-cal bg-cal px-6 py-3 font-body font-semibold text-azul focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cal"
			>
				Escríbeme por WhatsApp
			</a>
		</div>
	</section>

	<script is:inline>
		const t = (performance.now() / 1000).toFixed(2).replace('.', ',');
		document.getElementById('medidor').textContent = t;
	</script>
</Base>
