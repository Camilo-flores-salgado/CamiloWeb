---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description: string;
	path: string;
	noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonicalUrl = new URL(path, Astro.site!).toString();

const archivoExpanded = (await import('../assets/fonts/archivo-expanded-700.woff2?url')).default;
const sourceSerif400 = (await import('@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url')).default;
const sourceSerif600 = (await import('@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url')).default;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonicalUrl} />

		<!-- TODO: og:image queda pendiente hasta tener una imagen OG -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preload" as="font" type="font/woff2" href={archivoExpanded} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={sourceSerif400} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={sourceSerif600} crossorigin />

		<!-- Cloudflare Web Analytics -->
		<script
			type="module"
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon='{"token": "7aa1331382ec4ee3ac24ea4d3597cb1c"}'
			is:inline></script>
		<!-- End Cloudflare Web Analytics -->
	</head>
	<body>
		<Nav />
		<slot />
	</body>
</html>
